{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

{% if session.logged_in %}
  <nav id="bottom-bar-hidden">
  {%set user_id = session["user"]["id"]%}
    <a href="/profile/{{user_id}}" class="nav-item-selected"><img src="/static/images/profile.svg" alt="My profile" class="nav-img"></a>
        <a href="/" class="nav-item"><img src="/static/images/home4.svg" alt="Home" class="nav-img"></a>
    <a href="/report_ghost" class="nav-item"><img src="/static/images/write.svg" alt="Report Ghost" class="nav-img"></a>
</nav>
{% endif %}   






<div class="profile">
<img src="/static/uploads/{{ user.profile_picture }}" id="profile-pic" alt="Users Profile Picture">
<h1>{{user.forename}} {{user.surname}}</h1>
<strong>@{{user.username}}</strong>
{% if user.bio == None%}
<p>This user has not set a bio yet!</p>
{%else%}
<p>{{user.bio}}</p>
{%endif%}
{% if session["user"]["id"] == user.id%}
<p><a href="/profile/{{user.id}}/edit" class="nav-item">Edit Profile</a> | <a href="/logout" class="nav-item">Logout</a></p>
{%endif%}


</div>

{% if previous_hunts%}
<div class="profile">
<h2>Previous Hunts:</h2>
{%for hunt in previous_hunts%}
<p><a href="/view_hunt/{{hunt.id}}">{{hunt.location}} | {{hunt.status}}</a></p>
<br>
{%endfor%}
</div>
{%endif%}


{% if reported_hunts%}
<div class="profile">
<h2>Reported Hunts:</h2>   
{% for hunt in reported_hunts%}
<p><a href="/view_hunt/{{hunt.id}}">{{hunt.location}} | {{hunt.status}}</a></p>
<br>
{%endfor%}
</div>
{%endif%}

{% endblock %}

