{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
{# If logged in and ghost hunter: Show all hunts available, plus the hunts you've signed up to.  #}
{# if logged in and *not* a ghost hunter: Show only the hunts you've reported. #}
{# If not logged in: Show all hunts available.  #}





    <h2>All hunts available: </h2>
    {%for hunt in hunts %}
    <br>
   <a href="/view_hunt/{{hunt.id}}">{{hunt.location}}</a>
   <p> Hunt status: {{hunt.status}}</p>
    {%endfor%}

  
  {% if myHunts  %}
  <h2>My hunts:</h2>
    {%for hunt in myHunts %}
      <br>
      <a href="/view_hunt/{{hunt.id}}">{{hunt.location}}</a>
         <p> Hunt status: {{hunt.status}}</p>


      {%endfor%}
    {%endif%}
    
   


{% endblock %}

