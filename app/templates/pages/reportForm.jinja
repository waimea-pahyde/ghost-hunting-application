{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}
<script>
const autofillElement = new MapboxAddressAutofill();
autofillElement.accessToken = 'pk.eyJ1IjoicGFoeWRlIiwiYSI6ImNtdTYxY2xweDAwMmcyeXEwbTNmYWE5d3MifQ.VDpgTF7gbW36oKAKm_SmWQ';
autofillElement.options = { country: 'nz' };

const addressInput = document.getElementById('address-input');
const addressForm = addressInput.parentElement;

// wrap the <input> with the MapboxAddressAutofill instance
autofillElement.appendChild(addressInput);
addressForm.appendChild(autofillElement);


</script>

<h1>Make a Ghost Report</h1>

    <section class="form-sec">

    <form method="post" action="/sendReport" enctype="multipart/form-data">
      

      <mapbox-address-autofill access-token="pk.eyJ1IjoicGFoeWRlIiwiYSI6ImNtdTYxY2xweDAwMmcyeXEwbTNmYWE5d3MifQ.VDpgTF7gbW36oKAKm_SmWQ">
      <input type="text" name="street" autocomplete="address-line1" placeholder="Location of ghost..."/> {#Look at floating labels later if there's time. They look interesting. #}
      </mapbox-address-autofill>

        <input type="text" name="town" autocomplete="address-level2" placeholder="Town of ghost" />

      <input type="text" name="country" autocomplete="country-name" placeholder="Country of ghost" />

      <input type="text" name="description" required placeholder="Description of ghost sighting...">
      <br>
      <label>
        Submit Photos:
        <input
            name="images"
            type="file"
            accept="image/png, image/jpeg, image/gif, image/webp"
            multiple
        >
    </label>
      <button >Submit</button>


    </form>
</section>

{% endblock %}

